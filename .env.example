# Environment Variables Template

# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# NEVER share the .env file with unauthorized personnel

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000
API_VERSION=v1

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# For Local PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pharezdb
# DB_USER=pharezdb_user
# DB_PASSWORD=your_secure_password

# For Cloud PostgreSQL (Render, AWS RDS, Neon, etc.):
DB_HOST=your_cloud_db_host.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_secure_database_password
DB_SSL=true

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_strong_random_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d
DEFAULT_PASSWORD=SecureDefaultPassword123!

# ==========================================
# EMAIL CONFIGURATION (Choose ONE option)
# ==========================================

# OPTION 1: SendGrid (Recommended for production)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@your-domain.com

# OPTION 2: Gmail SMTP
# Requires App Password (not regular password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_specific_password_here
# EMAIL_FROM=Pharez <your_email@gmail.com>

# ==========================================
# PAYMENT GATEWAY CONFIGURATION (Remita)
# ==========================================
# For production, update to live credentials
REMITA_BASE_URL=https://demo.remita.net/remita/exapp/api/v1/send/api/echannelsvc
REMITA_MERCHANT_ID=your_merchant_id
REMITA_API_KEY=your_remita_api_key
REMITA_SERVICE_TYPE_ID=your_service_type_id

# ==========================================
# JED ECOSYSTEM INTEGRATION
# ==========================================
JED_BASE_URL=https://jedecosystem.com/map/api
JED_API_KEY=your_jed_api_key

# ==========================================
# SMS SERVICE CONFIGURATION (Termii)
# ==========================================
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Pharez

# ==========================================
# BUSINESS CONFIGURATION
# ==========================================
SINGLE_PHASE_METER_PRICE=135000
THREE_PHASE_METER_PRICE=209000

# ==========================================
# OPTIONAL: EXTERNAL SERVICES
# ==========================================
# Add any additional third-party service keys here
# Example:
# ANALYTICS_KEY=your_analytics_key
# STRIPE_SECRET_KEY=your_stripe_key
